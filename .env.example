# انسخ هذا الملف إلى .env واملأ القيم
# Copy to .env and fill values

# مفتاح الذكاء الاصطناعي (OpenAI أو Groq أو OpenRouter - نفس البروتوكول)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Meta (Facebook + Instagram + Messenger) - من developers.facebook.com
META_PAGE_TOKEN=
PAGE_ID=1241009282437968
META_VERIFY_TOKEN=my_secret_verify_123
META_APP_SECRET=

# WhatsApp Cloud API - من developers.facebook.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# TikTok (اختياري - يحتاج موافقة TikTok Audit)
TIKTOK_ACCESS_TOKEN=

# Google Sheets (اختياري - مجاني عبر Apps Script Web App URL)
GOOGLE_SHEETS_WEBHOOK=

# مبدّل التعليقات الاحتياطي (polling كل 90 ثانية)
POLL_ENABLED=1
POLL_INTERVAL_SEC=90
POLL_LOOKBACK_MIN=30

# عام
BUSINESS_NAME=متجرك
DEFAULT_CURRENCY=دج
PORT=8000
